# Google AI Studio
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash-live-001
GEMINI_VOICE=Kore

# Twilio: the auth token is what webhook signatures are checked against
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY=1

# The hostname Twilio calls. It must match the webhook URL exactly.
PUBLIC_HOST=

# Where transfer_call sends people. Unset means transfers are refused rather than faked.
RECEPTION_NUMBER=

BUSINESS_NAME=Northgate Bicycle Workshop
GREETING=Thanks for calling. How can I help?
